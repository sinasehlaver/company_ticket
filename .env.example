# Node app (web/). Local dev: leave DATABASE_URL unset to use web/data/company.db (./start.sh sets dev passwords).
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=
# NODE_ENV=production        # requires a libsql:// or https:// DATABASE_URL (ALLOW_FILE_DB=1 to test locally)
# HOST=127.0.0.1
# PORT=5140
# ADMIN_USERNAME=sina
# ADMIN_PASSWORD=
# BASKAN_USERNAME=baskan
# BASKAN_PASSWORD=
# TICKET_USER_PASSWORD=
# BACKUP_KEY=                # 32 bytes, base64 or 64 hex: openssl rand -base64 32
